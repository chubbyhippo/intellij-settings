<keymap version="1" name="emacs" parent="Emacs">
  <action id="$Cut">
    <keyboard-shortcut first-keystroke="shift delete" />
    <keyboard-shortcut first-keystroke="shift ctrl back_space" />
  </action>
  <action id="$LRU">
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="shift o" />
  </action>
  <action id="AIAssistant.Editor.AskAiAssistantInEditor" />
  <action id="ActivateBookmarksToolWindow">
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="b" />
  </action>
  <action id="ActivateCommitToolWindow">
    <keyboard-shortcut first-keystroke="alt 0" />
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="c" />
    <keyboard-shortcut first-keystroke="ctrl semicolon" second-keystroke="c" />
  </action>
  <action id="ActivateMavenToolWindow">
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="m" />
  </action>
  <action id="ActivateProjectToolWindow">
    <keyboard-shortcut first-keystroke="alt 1" />
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="e" />
    <keyboard-shortcut first-keystroke="ctrl semicolon" second-keystroke="e" />
    <keyboard-shortcut first-keystroke="ctrl semicolon" second-keystroke="p" />
  </action>
  <action id="ActivateStructureToolWindow">
    <keyboard-shortcut first-keystroke="alt 7" />
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="s" />
  </action>
  <action id="ActivateTerminalToolWindow">
    <keyboard-shortcut first-keystroke="alt f12" />
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="t" />
    <keyboard-shortcut first-keystroke="ctrl semicolon" second-keystroke="t" />
  </action>
  <action id="ActivateVersionControlToolWindow">
    <keyboard-shortcut first-keystroke="alt 9" />
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="g" />
    <keyboard-shortcut first-keystroke="ctrl semicolon" second-keystroke="g" />
  </action>
  <action id="Annotate">
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="shift b" />
  </action>
  <action id="ChangeKeymap">
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="k" />
  </action>
  <action id="ChangesView.Revert">
    <keyboard-shortcut first-keystroke="ctrl alt z" />
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="shift r" />
  </action>
  <action id="CloseContent">
    <keyboard-shortcut first-keystroke="ctrl f4" />
    <keyboard-shortcut first-keystroke="ctrl x" second-keystroke="k" />
  </action>
  <action id="CollapseAll">
    <keyboard-shortcut first-keystroke="ctrl subtract" />
    <keyboard-shortcut first-keystroke="shift alt minus" />
  </action>
  <action id="CollapseRegion">
    <keyboard-shortcut first-keystroke="ctrl subtract" />
    <keyboard-shortcut first-keystroke="shift alt minus" />
  </action>
  <action id="Editor Cut">
    <keyboard-shortcut first-keystroke="shift ctrl back_space" />
  </action>
  <action id="Editor LRU">
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="shift o" />
  </action>
  <action id="EditorBackwardParagraph">
    <keyboard-shortcut first-keystroke="ctrl up" />
    <keyboard-shortcut first-keystroke="shift alt open_bracket" />
  </action>
  <action id="EditorEnter">
    <keyboard-shortcut first-keystroke="enter" />
    <keyboard-shortcut first-keystroke="ctrl m" />
    <keyboard-shortcut first-keystroke="ctrl j" />
  </action>
  <action id="EditorForwardParagraph">
    <keyboard-shortcut first-keystroke="ctrl down" />
    <keyboard-shortcut first-keystroke="shift alt close_bracket" />
  </action>
  <action id="EditorSelectWord">
    <keyboard-shortcut first-keystroke="ctrl alt w" />
    <keyboard-shortcut first-keystroke="ctrl equals" />
  </action>
  <action id="EditorUnSelectWord">
    <keyboard-shortcut first-keystroke="shift ctrl w" />
    <keyboard-shortcut first-keystroke="ctrl minus" />
  </action>
  <action id="ExpandAll">
    <keyboard-shortcut first-keystroke="ctrl add" />
    <keyboard-shortcut first-keystroke="shift alt equals" />
  </action>
  <action id="ExpandRegion">
    <keyboard-shortcut first-keystroke="ctrl add" />
    <keyboard-shortcut first-keystroke="shift alt equals" />
  </action>
  <action id="Git.Fetch">
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="f" />
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="shift f" />
    <keyboard-shortcut first-keystroke="ctrl comma" second-keystroke="f" />
  </action>
  <action id="Git.Pull">
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="p" />
    <keyboard-shortcut first-keystroke="ctrl comma" second-keystroke="p" />
  </action>
  <action id="GotoLine">
    <keyboard-shortcut first-keystroke="alt g" second-keystroke="g" />
  </action>
  <action id="GotoNextError">
    <keyboard-shortcut first-keystroke="f2" />
    <keyboard-shortcut first-keystroke="ctrl x" second-keystroke="back_quote" />
    <keyboard-shortcut first-keystroke="alt g" second-keystroke="n" />
  </action>
  <action id="GotoPreviousError">
    <keyboard-shortcut first-keystroke="shift f2" />
    <keyboard-shortcut first-keystroke="shift ctrl x" second-keystroke="back_quote" />
    <keyboard-shortcut first-keystroke="alt g" second-keystroke="p" />
  </action>
  <action id="HideAllWindows">
    <keyboard-shortcut first-keystroke="shift ctrl f12" />
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="h" />
  </action>
  <action id="InsertLiveTemplate" />
  <action id="JumpToLastChange" />
  <action id="NewScratchFile">
    <keyboard-shortcut first-keystroke="shift ctrl alt insert" />
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="n" />
    <keyboard-shortcut first-keystroke="ctrl semicolon" second-keystroke="n" />
  </action>
  <action id="RefactoringMenu">
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="r" />
    <keyboard-shortcut first-keystroke="ctrl semicolon" second-keystroke="r" />
  </action>
  <action id="ReformatCode">
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="f" />
    <keyboard-shortcut first-keystroke="ctrl alt l" />
  </action>
  <action id="ResetIdeScaleAction">
    <keyboard-shortcut first-keystroke="shift alt 0" />
    <keyboard-shortcut first-keystroke="ctrl x" second-keystroke="ctrl 0" />
  </action>
  <action id="RestartIde">
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="shift s" />
  </action>
  <action id="RevealIn">
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="shift e" />
  </action>
  <action id="RunAnything" />
  <action id="RunContextPopupGroup">
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="x" />
  </action>
  <action id="RunDashboard.Run">
    <keyboard-shortcut first-keystroke="shift ctrl f10" />
  </action>
  <action id="SurroundWith">
    <keyboard-shortcut first-keystroke="ctrl alt t" />
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="w" />
  </action>
  <action id="Terminal.ClearPrompt" />
  <action id="Terminal.CopySelectedText">
    <keyboard-shortcut first-keystroke="ctrl insert" />
  </action>
  <action id="Vcs.Push">
    <keyboard-shortcut first-keystroke="shift ctrl k" />
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="shift p" />
    <keyboard-shortcut first-keystroke="ctrl comma" second-keystroke="shift p" />
  </action>
  <action id="ZoomInIdeAction">
    <keyboard-shortcut first-keystroke="ctrl x" second-keystroke="ctrl equals" />
  </action>
  <action id="ZoomOutIdeAction">
    <keyboard-shortcut first-keystroke="ctrl x" second-keystroke="ctrl minus" />
  </action>
  <action id="runShellFileAction">
    <keyboard-shortcut first-keystroke="shift ctrl f10" />
  </action>
</keymap>