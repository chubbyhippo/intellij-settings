<keymap version="1" name="emacs" parent="Emacs">
  <action id="ActivateBookmarksToolWindow" />
  <action id="ActivateCommitToolWindow">
    <keyboard-shortcut first-keystroke="alt 0" />
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="c" />
  </action>
  <action id="ActivateProjectToolWindow">
    <keyboard-shortcut first-keystroke="alt 1" />
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="e" />
  </action>
  <action id="ActivateStructureToolWindow">
    <keyboard-shortcut first-keystroke="alt 7" />
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="s" />
  </action>
  <action id="ActivateTerminalToolWindow">
    <keyboard-shortcut first-keystroke="alt f12" />
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="t" />
  </action>
  <action id="ActivateVersionControlToolWindow">
    <keyboard-shortcut first-keystroke="alt 9" />
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="g" />
  </action>
  <action id="ChangeKeymap">
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="k" />
  </action>
  <action id="ChangesView.Revert">
    <keyboard-shortcut first-keystroke="ctrl alt z" />
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="shift r" />
  </action>
  <action id="EditorSelectWord">
    <keyboard-shortcut first-keystroke="ctrl alt w" />
    <keyboard-shortcut first-keystroke="ctrl equals" />
  </action>
  <action id="EditorUnSelectWord">
    <keyboard-shortcut first-keystroke="shift ctrl w" />
    <keyboard-shortcut first-keystroke="ctrl minus" />
  </action>
  <action id="Git.Fetch">
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="f" />
  </action>
  <action id="Git.Pull">
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="p" />
  </action>
  <action id="HideAllWindows">
    <keyboard-shortcut first-keystroke="shift ctrl f12" />
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="h" />
  </action>
  <action id="RevealIn">
    <keyboard-shortcut first-keystroke="ctrl c" second-keystroke="shift e" />
  </action>
  <action id="RunAnything" />
  <action id="Terminal.ClearPrompt" />
  <action id="Terminal.CopySelectedText">
    <keyboard-shortcut first-keystroke="ctrl insert" />
  </action>
</keymap>